<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:HighSchoolEcosystem.Controls"
             xmlns:viewModels="clr-namespace:HighSchoolEcosystem.ViewModels"
             x:Class="HighSchoolEcosystem.Views.TeacherTimetablePage"
             x:DataType="viewModels:TeacherTimetableViewModel"
             Title="Timetable">
    <!-- A one-button sidebar: the same left edge as the dashboards,
         carrying the one thing a pushed page needs - a way home. -->
    <Grid ColumnDefinitions="44,*">
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*" Padding="20,0,20,20" RowSpacing="12">

            <VerticalStackLayout Grid.Row="0" Spacing="0" Margin="-20,-20,-20,0">
                <VerticalStackLayout BackgroundColor="{StaticResource BrandDark}" Padding="16,18" Spacing="3">
                    <Label Text="Timetable" FontSize="20" FontAttributes="Bold"
                           TextColor="{StaticResource White}" />
                    <Label Text="Weekly periods for the classes you teach" FontSize="12"
                           TextColor="{StaticResource White}" Opacity="0.85" />
                </VerticalStackLayout>
                <BoxView Style="{StaticResource NavRuleBar}" />
            </VerticalStackLayout>


            <VerticalStackLayout Grid.Row="1" Spacing="8">
                <Label Text="Add a weekly period" FontAttributes="Bold" />
                <Picker ItemsSource="{Binding AvailableClasses}" SelectedItem="{Binding SelectedClass}"
                        ItemDisplayBinding="{Binding Name, x:DataType=viewModels:TeacherClassRow}"
                        Title="Class" />
                <Picker ItemsSource="{Binding Days}" SelectedItem="{Binding SelectedDay}" Title="Day" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <TimePicker Grid.Column="0" Time="{Binding StartTime}" />
                    <TimePicker Grid.Column="1" Time="{Binding EndTime}" />
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Entry Grid.Column="0" Placeholder="Period no." Keyboard="Numeric" Text="{Binding Period}" />
                    <Entry Grid.Column="1" Placeholder="Room" Text="{Binding Room}" />
                </Grid>
                <Button Text="Add period" Command="{Binding AddCommand}" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="2" Spacing="4">
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                <Label Text="{Binding StatusMessage}" FontSize="13" />
            </VerticalStackLayout>

            <RefreshView Grid.Row="3" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
                <CollectionView ItemsSource="{Binding Entries}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:TimetableRow">
                            <Grid Padding="4,12" ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Title}" FontSize="15" />
                                    <Label Text="{Binding Subtitle}" Style="{StaticResource RowSubtle}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="Remove" FontSize="13"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:TeacherTimetableViewModel}}, Path=DeleteCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <Label Text="No periods scheduled yet." Style="{StaticResource RowSubtle}" />
                    </CollectionView.EmptyView>
                </CollectionView>
            </RefreshView>
        </Grid>
        <!-- Declared LAST so it draws on top: several pages bleed
             their header past the content edge with a negative
             margin, which would otherwise paint over the rail. -->
        <controls:HomeRail Grid.Column="0" />
    </Grid>
</ContentPage>
