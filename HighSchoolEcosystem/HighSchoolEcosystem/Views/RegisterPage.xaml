<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:HighSchoolEcosystem.ViewModels"
             x:Class="HighSchoolEcosystem.Views.RegisterPage"
             x:DataType="viewModels:RegisterViewModel"
             Title="Create account">
    <ScrollView Style="{StaticResource PageCanvas}">
        <VerticalStackLayout Padding="32" Spacing="16" VerticalOptions="Center">
            <Label Text="Create your account" Style="{StaticResource Headline}" />
            <Entry Placeholder="Full name" Text="{Binding FullName}" />
            <Entry Placeholder="Email address" Keyboard="Email" Text="{Binding Email}" />
            <Entry Placeholder="Password (at least 8 characters)" IsPassword="True" Text="{Binding Password}" />
            <Entry Placeholder="Confirm password" IsPassword="True" Text="{Binding ConfirmPassword}" />
            <Button Text="Create account" Command="{Binding RegisterCommand}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding StatusMessage}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
