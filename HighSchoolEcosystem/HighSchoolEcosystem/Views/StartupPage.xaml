<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HighSchoolEcosystem.Views.StartupPage"
             Title="Loading"
             NavigationPage.HasNavigationBar="False">
    <VerticalStackLayout Padding="32" Spacing="16" VerticalOptions="Center" HorizontalOptions="Center">
        <ActivityIndicator IsRunning="True" />
        <Label x:Name="StatusLabel" Text="Loading…" HorizontalTextAlignment="Center" />
    </VerticalStackLayout>
</ContentPage>
