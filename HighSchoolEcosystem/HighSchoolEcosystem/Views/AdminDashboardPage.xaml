<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:HighSchoolEcosystem.ViewModels"
             xmlns:controls="clr-namespace:HighSchoolEcosystem.Controls"
             x:Class="HighSchoolEcosystem.Views.AdminDashboardPage"
             x:DataType="viewModels:AdminDashboardViewModel"
             Title="Admin">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Account" Clicked="OnAccountClicked" />
    </ContentPage.ToolbarItems>

    <!-- Single cell: the rail floats over the content rather than
         taking a column, so expanding it covers rather than squeezes. -->
    <Grid>

        <!-- Pull to refresh. Wraps only the ScrollView: the rail must stay
             outside so dragging the page doesn't drag the rail with it, and so
             it still draws last, on top. -->
        <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
        <ScrollView x:Name="ContentScroll" Style="{StaticResource PageCanvas}">
        <VerticalStackLayout Spacing="0">

            <Grid Style="{StaticResource NavBar}" ColumnDefinitions="*,Auto">
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                    <Label Text="{Binding SchoolName}" Style="{StaticResource NavWordmark}" />
                    <Label Text="Administrator" Style="{StaticResource RowSubtle}" />
                </VerticalStackLayout>
                <Label Grid.Column="1" Text="{Binding DisplayName}" FontSize="13"
                       VerticalOptions="Center" />
            </Grid>
            <BoxView Style="{StaticResource NavRuleBar}" />

            <!-- 44 on the left clears the floating rail. -->
                <VerticalStackLayout Padding="50,12,8,12" Spacing="12">

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                <Label Text="{Binding StatusMessage}" Style="{StaticResource RowMetaOverdue}"
                       IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmpty}}" />

                <!-- ============ School administration ============ -->

                <Border x:Name="ToolsSection" Style="{StaticResource Widget}">
                    <VerticalStackLayout Spacing="0">
                        <HorizontalStackLayout Margin="0,0,0,12">
                            <Label Text="School administration" Style="{StaticResource WidgetTitle}" />
                            <Label Style="{StaticResource WidgetChevron}" />
                        </HorizontalStackLayout>

                        <!-- Announcements are composed from the Announcements
                             section on the dashboard, not from here — the form
                             sits next to the notices it produces. -->
                        <Grid ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnManageUsersClicked" />
                            </Grid.GestureRecognizers>
                            <VerticalStackLayout Grid.Column="0" Spacing="1">
                                <Label Text="Manage users" Style="{StaticResource ToolRowTitle}" />
                                <Label Text="Change roles for people who have already registered, and link parents to their children."
                                       Style="{StaticResource RowSubtle}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Style="{StaticResource ToolRowChevron}" />
                        </Grid>
                        <BoxView Style="{StaticResource SectionRule}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnInvitesClicked" />
                            </Grid.GestureRecognizers>
                            <VerticalStackLayout Grid.Column="0" Spacing="1">
                                <Label Text="Roster and invites" Style="{StaticResource ToolRowTitle}" />
                                <Label Text="Pre-assign a role by email so it applies the moment someone signs up."
                                       Style="{StaticResource RowSubtle}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Style="{StaticResource ToolRowChevron}" />
                        </Grid>
                        <BoxView Style="{StaticResource SectionRule}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSettingsClicked" />
                            </Grid.GestureRecognizers>
                            <VerticalStackLayout Grid.Column="0" Spacing="1">
                                <Label Text="School settings" Style="{StaticResource ToolRowTitle}" />
                                <Label Text="Name and branding colours shown across the app."
                                       Style="{StaticResource RowSubtle}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Style="{StaticResource ToolRowChevron}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ============ Other roles ============ -->

                <Border x:Name="RolesSection" Style="{StaticResource Widget}">
                    <Border.Triggers>
                        <MultiTrigger TargetType="Border">
                            <MultiTrigger.Conditions>
                                <BindingCondition Binding="{Binding HasPersonalView}" Value="False" />
                                <BindingCondition Binding="{Binding IsAlsoTeacher}" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter Property="IsVisible" Value="False" />
                        </MultiTrigger>
                    </Border.Triggers>
                    <VerticalStackLayout Spacing="0">
                        <HorizontalStackLayout Margin="0,0,0,12">
                            <Label Text="Your other roles" Style="{StaticResource WidgetTitle}" />
                            <Label Style="{StaticResource WidgetChevron}" />
                        </HorizontalStackLayout>

                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasPersonalView}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPersonalViewClicked" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="{Binding PersonalViewLabel}"
                                   Style="{StaticResource ToolRowTitle}" />
                            <Label Grid.Column="1" Style="{StaticResource ToolRowChevron}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsAlsoTeacher}"
                              Margin="0,10,0,0">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTeacherToolsClicked" />
                            </Grid.GestureRecognizers>
                            <VerticalStackLayout Grid.Column="0" Spacing="1">
                                <Label Text="Teacher tools" Style="{StaticResource ToolRowTitle}" />
                                <Label Text="Your classes, assignments and timetable."
                                       Style="{StaticResource RowSubtle}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Style="{StaticResource ToolRowChevron}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ============ Not built yet ============ -->

                <Border x:Name="ContentSection" Style="{StaticResource Widget}">
                    <VerticalStackLayout Spacing="0">
                        <HorizontalStackLayout Margin="0,0,0,10">
                            <Label Text="School content" Style="{StaticResource WidgetTitle}" />
                            <Label Style="{StaticResource WidgetChevron}" />
                        </HorizontalStackLayout>
                        <Border Style="{StaticResource WidgetInset}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Announcements · Timetable · Sports · Classes · Gradebook"
                                       Style="{StaticResource EmptyStateText}" />
                                <Label Text="These arrive in later milestones — see PLAN.md."
                                       Style="{StaticResource RowSubtle}" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>


                <!-- ============ Announcements ============ -->

                <!--
                    Read-only on this dashboard. Composing a school-wide notice
                    lives with the admin tools; this is here so nobody has to
                    switch roles to find out what the school has been told.
                -->
                <Border x:Name="AnnouncementsSection" Style="{StaticResource Widget}">
                    <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8" Margin="0,0,0,12">
                            <Label Grid.Column="0" Text="Announcements"
                                   Style="{StaticResource WidgetTitle}" />
                            <Border Grid.Column="1" Style="{StaticResource CountBadge}"
                                    IsVisible="{Binding HasAnnouncements}">
                                <Label Text="{Binding AnnouncementsCount}"
                                       Style="{StaticResource CountBadgeText}" />
                            </Border>
                            <Label Grid.Column="2" Style="{StaticResource WidgetChevron}" />
                        </Grid>

                        <!-- School-wide notices are admin-only, and are written
                             on the school dashboard where the composer lives.
                             Hidden for everyone else. -->
                        <Button Text="New announcement" Style="{StaticResource BrandButtonOutline}"
                                HorizontalOptions="Start" FontSize="12"
                                Padding="12,6" MinimumHeightRequest="36" Margin="0,0,0,10"
                                IsVisible="{Binding CanManageAnnouncements}"
                                Clicked="OnPostAnnouncementClicked" />

                        <FlexLayout BindableLayout.ItemsSource="{Binding Announcements}"
                                    Style="{StaticResource TileGrid}"
                                    IsVisible="{Binding HasAnnouncements}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:AnnouncementRow">
                                    <Border Style="{StaticResource TileWide}">
                                        <!-- Tap for the whole notice and its byline. -->
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnAnnouncementTapped" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="0">
                                            <BoxView Style="{StaticResource TileAccent}"
                                                     Color="{StaticResource BrandBright}" />
                                            <VerticalStackLayout Style="{StaticResource TileBody}">
                                                <Label Text="{Binding ScopeLabel}"
                                                       Style="{StaticResource TileKicker}" />
                                                <Label Text="{Binding Title}"
                                                       Style="{StaticResource TileTitle}"
                                                       FontAttributes="Bold" HeightRequest="36" />
                                                <Label Text="{Binding Body}"
                                                       Style="{StaticResource TileSubtle}" />
                                                <Label Text="{Binding MetaLine}"
                                                       Style="{StaticResource TileMeta}" />
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>

                        <Border Style="{StaticResource WidgetInset}"
                                IsVisible="{Binding AnnouncementsEmptyMessage, Converter={StaticResource StringNotEmpty}}">
                            <Label Text="{Binding AnnouncementsEmptyMessage}"
                                   Style="{StaticResource EmptyStateText}" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- ============ Sport ============ -->

                <Border x:Name="SportsSection" Style="{StaticResource Widget}">
                    <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8" Margin="0,0,0,12">
                            <Label Grid.Column="0" Text="Sport"
                                   Style="{StaticResource WidgetTitle}" />
                            <Border Grid.Column="1" Style="{StaticResource CountBadge}"
                                    IsVisible="{Binding HasSports}">
                                <Label Text="{Binding SportsCount}"
                                       Style="{StaticResource CountBadgeText}" />
                            </Border>
                            <Label Grid.Column="2" Style="{StaticResource WidgetChevron}" />
                        </Grid>

                        <!-- Posting needs sport, team, opponent, venue, date and
                             time, which is a form rather than a widget — so the
                             button opens the sports page where those fields are.
                             Hidden unless the rules would actually accept it. -->
                        <Button Text="Post to sport" Style="{StaticResource BrandButtonOutline}"
                                HorizontalOptions="Start" FontSize="12"
                                Padding="12,6" MinimumHeightRequest="36" Margin="0,0,0,10"
                                IsVisible="{Binding CanPostSports}"
                                Clicked="OnPostSportsClicked" />

                        <FlexLayout BindableLayout.ItemsSource="{Binding SportsItems}"
                                    Style="{StaticResource TileGrid}"
                                    IsVisible="{Binding HasSports}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:SportsRow">
                                    <Border Style="{StaticResource Tile}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnSportsItemTapped" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="0">
                                            <BoxView Style="{StaticResource TileAccent}"
                                                     Color="{StaticResource BrandAccent}" />
                                            <Image Source="{Binding ImageUrl}" Aspect="AspectFill"
                                                   HeightRequest="72"
                                                   IsVisible="{Binding HasImage}" />
                                            <VerticalStackLayout Style="{StaticResource TileBody}">
                                                <Label Text="{Binding KindLabel}"
                                                       Style="{StaticResource TileKicker}" />
                                                <Label Text="{Binding Title}"
                                                       Style="{StaticResource TileTitle}"
                                                       HeightRequest="36" />
                                                <Label Text="{Binding MetaLine}"
                                                       Style="{StaticResource TileMeta}" />
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>

                        <Border Style="{StaticResource WidgetInset}"
                                IsVisible="{Binding SportsEmptyMessage, Converter={StaticResource StringNotEmpty}}">
                            <Label Text="{Binding SportsEmptyMessage}"
                                   Style="{StaticResource EmptyStateText}" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- ============ Newspaper ============ -->
                <!-- Shared control - see Controls/NewspaperWidget.xaml. Hidden for
                     visitors and guests; the rail item follows the same test. -->
                <controls:NewspaperWidget x:Name="NewspaperSection" />

            </VerticalStackLayout>
        </VerticalStackLayout>
        </ScrollView>
        </RefreshView>
    
        <!-- Declared last so it draws ON TOP of the content it floats over.
             Shared with every other role's dashboard — see NavigationRail.xaml. -->
        <controls:NavigationRail />
    </Grid>
</ContentPage>
