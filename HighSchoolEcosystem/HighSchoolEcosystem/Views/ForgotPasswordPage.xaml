<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:HighSchoolEcosystem.ViewModels"
             x:Class="HighSchoolEcosystem.Views.ForgotPasswordPage"
             x:DataType="viewModels:ForgotPasswordViewModel"
             Title="Reset password">
    <ScrollView Style="{StaticResource PageCanvas}">
        <VerticalStackLayout Padding="32" Spacing="16" VerticalOptions="Center">
            <Label Text="Reset your password" Style="{StaticResource Headline}" />
            <Label Text="Enter your account email and we will send a reset link." HorizontalTextAlignment="Center" />
            <Entry Placeholder="Email address" Keyboard="Email" Text="{Binding Email}" />
            <Button Text="Send reset link" Command="{Binding SendResetCommand}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding StatusMessage}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
