<?xml version="1.0" encoding="utf-8" ?>
<!--
    The Messages section on the teacher and parent dashboards: the latest three
    teacher-parent threads, unread ones bold with a dot, and a way into the full
    inbox. Reads its state from DashboardShellViewModel through the inherited
    BindingContext, like the Newspaper widget, and handles its own taps.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:HighSchoolEcosystem.ViewModels"
             x:Class="HighSchoolEcosystem.Controls.MessagesWidget"
             x:DataType="viewModels:DashboardShellViewModel"
             IsVisible="{Binding ShowsMessages}">

    <Border Style="{StaticResource Widget}">
        <VerticalStackLayout Spacing="0">
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8" Margin="0,0,0,10">
                <Label Grid.Column="0" Text="Messages" Style="{StaticResource WidgetTitle}" />
                <Label Grid.Column="1" Style="{StaticResource WidgetChevron}" />
                <Border Grid.Column="2" Style="{StaticResource UnreadBadge}" Margin="0" Stroke="Transparent"
                        HorizontalOptions="End" VerticalOptions="Center"
                        IsVisible="{Binding UnreadConversations.HasUnread}"
                        SemanticProperties.Description="{Binding UnreadConversations.Description}">
                    <Label Text="{Binding UnreadConversations.Label}" Style="{StaticResource UnreadBadgeText}" />
                </Border>
            </Grid>

            <Button Text="Open messages" Style="{StaticResource BrandButtonOutline}"
                    HorizontalOptions="Start" FontSize="12" Padding="12,6" MinimumHeightRequest="36"
                    Margin="0,0,0,10" Clicked="OnOpenClicked" />

            <BoxView Style="{StaticResource SectionRule}" IsVisible="{Binding HasRecentConversations}" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentConversations}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:ConversationRow">
                        <VerticalStackLayout Spacing="0">
                            <Grid Style="{StaticResource ListRow}" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnConversationTapped" />
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout Grid.Column="0" Spacing="1">
                                    <Label Text="{Binding OtherName}" Style="{StaticResource RowTitle}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsUnread}" Value="True">
                                                <Setter Property="FontAttributes" Value="Bold" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Text="{Binding About}" Style="{StaticResource RowMeta}" />
                                    <Label Text="{Binding Preview}" Style="{StaticResource RowSubtle}"
                                           MaxLines="1" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="6">
                                    <Label Text="{Binding TimeLabel}" Style="{StaticResource RowSubtle}" HorizontalOptions="End" />
                                    <Border Style="{StaticResource UnreadBadge}" Margin="0" Stroke="Transparent"
                                            HorizontalOptions="End" MinimumWidthRequest="12" HeightRequest="12" Padding="0"
                                            IsVisible="{Binding IsUnread}" SemanticProperties.Description="Unread" />
                                </VerticalStackLayout>
                            </Grid>
                            <BoxView Style="{StaticResource RowRule}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Label Text="{Binding MessagesSummary}" Style="{StaticResource RowSubtle}"
                   IsVisible="{Binding MessagesSummary, Converter={StaticResource StringNotEmpty}}" />
        </VerticalStackLayout>
    </Border>
</ContentView>
