rules_version = '2';

// This Firebase project serves exactly one school — there is no tenant/school
// switching at runtime. Each client gets their own Firebase project (and
// therefore their own database, own rules deployment, own branding in
// Configuration/appsettings.json). Collections are flat at the database root.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers -----------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isMember() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // NOTE ON CASING: FirestoreValueConverter (the C# client's REST
    // serializer) writes field names as the C# property name, verbatim —
    // i.e. PascalCase, not camelCase. Every field reference below must match
    // the C# model's property names exactly (Models/UserProfile.cs etc.),
    // or these rules will silently read the wrong (missing) field.
    function role() {
      return userDoc().data.Role;
    }

    // Additional roles held alongside the primary one. Absent on documents
    // written before multi-role support, hence the default.
    function extraRoles() {
      return userDoc().data.get('Roles', []);
    }

    // A user holds a role if it's their primary role OR appears in Roles.
    // Every get() here targets the same /users/{uid} path, which Firestore
    // caches per request — so the whole helper family costs one document read
    // no matter how many times it's called.
    //
    // Role values are written as-is from the C# `Role` enum (Role.ToString()),
    // which is PascalCase — keep these literals in sync with Models/Role.cs.
    function hasRole(r) {
      return isMember() && (role() == r || r in extraRoles());
    }

    function isAdmin() { return hasRole('Admin'); }
    function isTeacher() { return hasRole('Teacher'); }
    function isStudent() { return hasRole('Student'); }
    function isParent() { return hasRole('Parent'); }
    function isVisitor() { return hasRole('Visitor'); }
    function isCoach() { return hasRole('Coach'); }

    // Additive role: writes for the school newspaper and nothing else. Held
    // alongside Student or Teacher, so it grants no entitlements of its own
    // beyond the newspaper.
    function isJournalist() { return hasRole('Journalist'); }

    // Everyone with a genuine stake in the school's day-to-day data. Visitors
    // are deliberately excluded — they only get the public surface. Note a
    // Visitor who ALSO holds Student or Teacher does qualify, which is correct:
    // the wider entitlement wins.
    function isSchoolCommunity() {
      return isStudent() || isTeacher() || isParent() || isAdmin() || isCoach();
    }

    // Staff who can publish school-wide content. Journalist is deliberately
    // NOT here — a student journalist must not gain school-wide announcement
    // rights just by joining the newspaper.
    function isStaff() {
      return isTeacher() || isAdmin() || isCoach();
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ---- roster / invites ------------------------------------------------
    // The signed-in user's email, lower-cased, used as the invite document ID.

    function authEmail() {
      return request.auth.token.email.lower();
    }

    function hasInvite() {
      return isSignedIn() && request.auth.token.email != null &&
        exists(/databases/$(database)/documents/invites/$(authEmail()));
    }

    function invite() {
      return get(/databases/$(database)/documents/invites/$(authEmail())).data;
    }

    function emailVerified() {
      return isSignedIn() && request.auth.token.get('email_verified', false) == true;
    }

    // Roles that grant access to other people's data, so claiming one has to be
    // backed by proof the user actually controls the rostered mailbox.
    // Firebase lets anyone register any unclaimed address WITHOUT verifying it,
    // so without this check a stranger who guessed a rostered address (say
    // principal@school.org) could register it first and inherit that role.
    function isPrivilegedRole(r) {
      return r == 'Admin' || r == 'Teacher' || r == 'Parent' || r == 'Coach' || r == 'Journalist';
    }

    // Same test over a list of role names. Journalist counts: publishing to the
    // school newspaper under someone else's rostered identity is exactly the
    // kind of thing email verification is here to stop.
    function listHasPrivilegedRole(names) {
      return 'Admin' in names || 'Teacher' in names || 'Parent' in names
          || 'Coach' in names || 'Journalist' in names;
    }

    function isLinkedParent(studentId) {
      return isParent() &&
        studentId in userDoc().data.LinkedStudentIds;
    }

    function classDoc(classId) {
      return get(/databases/$(database)/documents/classes/$(classId)).data;
    }

    // For use where classId comes from the path and the class already exists —
    // i.e. subcollection rules and updates, never `create` (a get() on a
    // document that doesn't exist yet errors out and denies).
    function isClassTeacher(classId) {
      return isTeacher() && classDoc(classId).TeacherId == request.auth.uid;
    }

    function isClassStudent(classId) {
      return isStudent() && request.auth.uid in classDoc(classId).StudentIds;
    }

    // True when this parent is linked to at least one student in the class.
    //
    // Needed because isLinkedParent() takes a studentId, and paths like
    // /classes/{id}/assignments don't have one — but a parent still has to read
    // them, or their child's grade shows with no assignment title or due date
    // attached to it.
    function isParentOfClassMember(classId) {
      return isParent() &&
        classDoc(classId).StudentIds.hasAny(userDoc().data.LinkedStudentIds);
    }

    // ---- teams -----------------------------------------------------------
    //
    // A team is shaped like a class on purpose: an owner, a roster, and its own
    // notice board. Same helpers, same reasoning — see isClassTeacher above.

    function teamDoc(teamId) {
      return get(/databases/$(database)/documents/teams/$(teamId));
    }

    // For subcollection rules and updates, never `create` — a get() on a
    // document that doesn't exist yet errors out and denies.
    function isTeamCoach(teamId) {
      return isCoach() && teamDoc(teamId).data.CoachId == request.auth.uid;
    }

    function isTeamMember(teamId) {
      return isStudent() && request.auth.uid in teamDoc(teamId).data.MemberIds;
    }

    // True when this parent is linked to at least one member of the squad. A
    // practice time is exactly the sort of thing a parent has to know — they're
    // usually the lift.
    function isParentOfTeamMember(teamId) {
      return isParent() &&
        teamDoc(teamId).data.MemberIds.hasAny(userDoc().data.LinkedStudentIds);
    }

    // ---- school-wide config (branding fallback; app mainly reads this from
    // appsettings.json, but a Firestore copy lets admins tweak it without a
    // new app build) -----------------------------------------------------
    // NOTE: a single path segment (e.g. `/config`) addresses a *collection*
    // in Firestore, not a document — `match` rules with `allow` blocks must
    // point at a document (an even number of path segments). Hence /meta/config.

    match /meta/config {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- users ----------------------------------------------------------

    // The school's roster. Admins add an entry per person ahead of time;
    // a user may read their own entry (the app needs it to build their profile)
    // but nobody else's, and only admins can write.
    match /invites/{inviteEmail} {
      allow read: if isAdmin() ||
        (isSignedIn() && request.auth.token.email != null && inviteEmail == authEmail());
      allow write: if isAdmin();
    }

    // Privilege boundary. The client bootstraps its own profile document on
    // first sign-in (UserProfileService), so `create` has to be self-service —
    // but a user must NOT be able to hand themselves a privileged role, or
    // grant themselves access to another student's data as a "parent". So a
    // self-created profile must either match this user's roster entry exactly,
    // or — when they aren't on the roster — be a bare Student account.
    match /users/{uid} {
      // Staff can read the directory: a teacher building a class roster needs
      // student names, and a coach needs them for team rosters. Writes stay
      // admin-only, so this grants visibility, not control.
      // isLinkedParent so a parent can resolve their own children's names —
      // without it the parent dashboard can only show a UID. It grants sight of
      // exactly the students already linked to them by an admin, nobody else.
      allow read: if isSelf(uid) || isAdmin() || isStaff() || isLinkedParent(uid);

      allow create: if isAdmin() ||
        (isSelf(uid) && (createFromInvite() || createAsDefaultStudent()));

      // A user may edit their own profile (display name, etc.) but never their
      // own role or entitlements — those stay admin-only after creation.
      allow update: if isAdmin() || (
        isSelf(uid)
        && request.resource.data.Role == resource.data.Role
        && request.resource.data.get('Roles', []) == resource.data.get('Roles', [])
        && request.resource.data.get('ClassIds', []) == resource.data.get('ClassIds', [])
        && request.resource.data.get('LinkedStudentIds', []) == resource.data.get('LinkedStudentIds', [])
      );

      allow delete: if isAdmin();

      // Push notification targets: one document per installed device, holding
      // its FCM token. Only the owner touches them — the app writes on sign-in
      // and deletes on sign-out. Cloud Functions read them with admin rights to
      // send; no other user ever needs to see someone's tokens.
      match /devices/{deviceId} {
        allow read, delete: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['Token', 'Platform', 'UpdatedAt'])
          && request.resource.data.Token is string
          && request.resource.data.Token.size() < 4096;
      }
    }

    // A rostered user's profile must match their invite exactly — and if that
    // invite grants a privileged role, their email must be verified first.
    // A rostered Student can sign up and start immediately: the role grants no
    // access to anyone else's data, so the extra friction isn't worth it.
    function createFromInvite() {
      return hasInvite()
        && request.resource.data.Role == invite().Role
        // Roles must match the roster exactly too. Without this a user could
        // self-assign Roles: ['Admin'] on top of a Student primary role and
        // walk straight through every isAdmin() check.
        && request.resource.data.get('Roles', []) == invite().get('Roles', [])
        && request.resource.data.get('ClassIds', []) == invite().get('ClassIds', [])
        && request.resource.data.get('LinkedStudentIds', []) == invite().get('LinkedStudentIds', [])
        && (emailVerified()
            || !(isPrivilegedRole(invite().Role) || listHasPrivilegedRole(invite().get('Roles', []))));
    }

    function createAsDefaultStudent() {
      return !hasInvite()
        && request.resource.data.Role == 'Student'
        && request.resource.data.get('Roles', []).size() == 0
        && request.resource.data.get('ClassIds', []).size() == 0
        && request.resource.data.get('LinkedStudentIds', []).size() == 0;
    }

    // ---- classes, assignments, submissions -------------------------------

    // Class documents are readable by the whole school community rather than
    // only their own teacher/students. Two reasons: a teacher has to be able to
    // LIST /classes to find their own (a per-document get()-based rule fails the
    // whole query as soon as one document is denied), and parents need to see
    // their child's classes. Names, subjects and rosters are directory-level
    // information within a school; grades and submissions are not, and stay
    // locked down below.
    match /classes/{classId} {
      allow read: if isSchoolCommunity();

      // Create is separate: isClassTeacher() get()s a document that doesn't
      // exist yet. A teacher may only create a class owned by themselves.
      allow create: if isAdmin() ||
        (isTeacher() && request.resource.data.TeacherId == request.auth.uid);

      allow update, delete: if isAdmin() || isClassTeacher(classId);

      match /assignments/{assignmentId} {
        allow read: if isAdmin() || isClassTeacher(classId) || isClassStudent(classId) ||
          isParentOfClassMember(classId);
        allow write: if isAdmin() || isClassTeacher(classId);

        // Multiple-choice questions. Students in the class can read these —
        // they have to, to answer them — so these documents carry the question
        // text and options ONLY.
        match /questions/{questionId} {
          allow read: if isAdmin() || isClassTeacher(classId) || isClassStudent(classId);
          allow write: if isAdmin() || isClassTeacher(classId);
        }

        // The answer key, split out from the question for exactly one reason:
        // so students cannot read it. Same document ID as the question it
        // answers. Never fold CorrectIndex back into /questions.
        match /answerKeys/{questionId} {
          allow read, write: if isAdmin() || isClassTeacher(classId);
        }

        // NOTE: every student branch below requires isClassStudent(classId) as
        // well as isSelf(studentId). Without it any signed-in user — a visitor,
        // or a student in a different class — could write a submission document
        // under any assignment in the school, simply by using their own UID as
        // the document ID.
        match /submissions/{studentId} {
          allow read: if isAdmin() || isClassTeacher(classId) ||
            (isSelf(studentId) && isClassStudent(classId)) ||
            isLinkedParent(studentId);

          // Students submit their own work — text, answers and a file — but
          // never any field that decides or records marking.
          //
          // Grade and Feedback are the obvious ones. The rest matter too:
          //
          //   TeacherMarkedAt  — setting it would hide the work from the
          //                      teacher's "needs marking" queue.
          //   AutoMarkedAt     — the Cloud Function's loop guard skips anything
          //                      where AutoMarkedAt >= SubmittedAt, so a future
          //                      value would permanently block auto-marking.
          //   AutoScore/Max    — the function's own record of what it awarded.
          //
          // The function itself runs with Admin SDK credentials and bypasses
          // these rules, so protecting the fields costs it nothing.
          allow create: if isAdmin() || isClassTeacher(classId) || (
            isSelf(studentId)
            && isClassStudent(classId)
            && !('Grade' in request.resource.data)
            && !('Feedback' in request.resource.data)
            && !('TeacherMarkedAt' in request.resource.data)
            && !('AutoMarkedAt' in request.resource.data)
            && !('AutoScore' in request.resource.data)
            && !('AutoScoreMax' in request.resource.data)
          );

          allow update: if isAdmin() || isClassTeacher(classId) || (
            isSelf(studentId)
            && isClassStudent(classId)
            && request.resource.data.get('Grade', null) == resource.data.get('Grade', null)
            && request.resource.data.get('Feedback', null) == resource.data.get('Feedback', null)
            && request.resource.data.get('TeacherMarkedAt', null) == resource.data.get('TeacherMarkedAt', null)
            && request.resource.data.get('AutoMarkedAt', null) == resource.data.get('AutoMarkedAt', null)
            && request.resource.data.get('AutoScore', null) == resource.data.get('AutoScore', null)
            && request.resource.data.get('AutoScoreMax', null) == resource.data.get('AutoScoreMax', null)
          );

          allow delete: if isAdmin() || isClassTeacher(classId);
        }
      }

      // ---- course materials ---------------------------------------------

      // Chapters, links and uploaded files for the class. Read by anyone
      // enrolled; written only by the class's own teacher, or an admin.
      //
      // Note this sits alongside /assignments rather than under it: material
      // belongs to the course, not to a single piece of work, and a student
      // studying for a test shouldn't have to guess which assignment the notes
      // were attached to.
      // ---- class announcements ------------------------------------------

      // A notice from the class's own teacher to the students in it.
      //
      // A subcollection rather than a ClassId field on /announcements: the path
      // carries the class, so isClassTeacher(classId) gates the write directly
      // and enrolment gates the read. Tagging the school-wide collection would
      // have meant every reader filtering client-side, and a list query there
      // would hand one class's notices to the whole school.
      //
      // Note this is a WIDER write audience than /announcements, which stays
      // admin-only — but a narrower one in reach. A teacher can only ever
      // address their own class.
      match /announcements/{announcementId} {
        allow read: if isAdmin() || isClassTeacher(classId) || isClassStudent(classId) ||
          isParentOfClassMember(classId);

        allow create: if (isAdmin() || isClassTeacher(classId))
          // Byline pinned to the writer, same as everywhere else.
          && request.resource.data.AuthorId == request.auth.uid;

        allow update: if (isAdmin() || isClassTeacher(classId))
          && request.resource.data.AuthorId == resource.data.AuthorId;

        allow delete: if isAdmin() || isClassTeacher(classId);
      }

      // ---- learning units --------------------------------------------

      // The course's chapters. Same audience as materials — read by anyone
      // enrolled, written by the class's own teacher.
      match /units/{unitId} {
        allow read: if isAdmin() || isClassTeacher(classId) || isClassStudent(classId) ||
          isParentOfClassMember(classId);

        allow create: if (isAdmin() || isClassTeacher(classId))
          && request.resource.data.AuthorId == request.auth.uid;

        allow update: if (isAdmin() || isClassTeacher(classId))
          && request.resource.data.AuthorId == resource.data.AuthorId;

        allow delete: if isAdmin() || isClassTeacher(classId);
      }

      // ---- class group chat ----------------------------------------------

      // One group chat per class: its enrolled students and its teacher, and
      // nobody else. There is deliberately NO one-to-one messaging anywhere —
      // every message is visible to the whole class and its teacher.
      //
      // Parents are not members: this is the students' class space. Admins can
      // read and delete (moderation) but don't post.
      match /messages/{messageId} {
        allow read: if isAdmin() || isClassTeacher(classId) || isClassStudent(classId);

        // AuthorRole is checked against what the writer really is in THIS
        // class, so a student can't post with a "Teacher" label. SentAt must
        // be close to the server's clock: the chat is ordered by it, and a
        // far-future timestamp would pin a message to the bottom for ever.
        //
        // A message is text, an attachment (picture or file), or both. The
        // attachment's path must be in the SENDER's own chat folder for THIS
        // class (storage.rules only lets you upload there), so nobody can
        // attach someone else's file.
        allow create: if request.resource.data.AuthorId == request.auth.uid
          && request.resource.data.keys().hasOnly(['AuthorId', 'AuthorName', 'AuthorRole', 'Text', 'SentAt',
               'AttachmentUrl', 'AttachmentPath', 'AttachmentName', 'AttachmentKind', 'AttachmentSize'])
          && request.resource.data.Text is string
          && request.resource.data.Text.size() <= 1000
          && request.resource.data.get('AttachmentUrl', '') is string
          && request.resource.data.get('AttachmentPath', '') is string
          && request.resource.data.get('AttachmentKind', '') in ['', 'Image', 'File']
          && (request.resource.data.Text.size() > 0 || request.resource.data.get('AttachmentUrl', '') != '')
          && (request.resource.data.get('AttachmentPath', '') == ''
              || request.resource.data.AttachmentPath.matches(
                   'classes/' + classId + '/chat/' + request.auth.uid + '/[^/]+'))
          && request.resource.data.SentAt is timestamp
          && request.resource.data.SentAt > request.time - duration.value(10, 'm')
          && request.resource.data.SentAt < request.time + duration.value(10, 'm')
          && (
            (isClassTeacher(classId) && request.resource.data.AuthorRole == 'Teacher')
            || (isClassStudent(classId) && request.resource.data.AuthorRole == 'Student')
          );

        // No editing: a message that can be changed after people replied to it
        // makes the conversation unreliable. Delete and re-send instead.
        allow update: if false;

        // Your own message, or any message if you're the class's teacher or an
        // admin — that's the moderation.
        allow delete: if resource.data.AuthorId == request.auth.uid
          || isClassTeacher(classId) || isAdmin();
      }

      // ---- per-student progress ----------------------------------------

      // Which materials a student has ticked off. The document ID is their UID,
      // which is what makes "only your own" expressible without a lookup.
      //
      // The teacher can READ this — they need to see who is keeping up — but
      // deliberately cannot WRITE it. Progress is the student's own record of
      // what they've worked through; a teacher marking it on their behalf would
      // make it meaningless. Grades are the teacher's channel, not this.
      match /progress/{studentId} {
        allow read: if isAdmin() || isClassTeacher(classId) ||
          (isSelf(studentId) && isClassStudent(classId)) ||
          isLinkedParent(studentId);

        // isSelf AND isClassStudent, both: isSelf alone would let any signed-in
        // user create a progress document under a class they aren't in, simply
        // by using their own UID as the document ID.
        allow create, update: if isSelf(studentId) && isClassStudent(classId);

        allow delete: if isAdmin() || isClassTeacher(classId);
      }

      match /materials/{materialId} {
        allow read: if isAdmin() || isClassTeacher(classId) || isClassStudent(classId) ||
          isParentOfClassMember(classId);

        allow create: if (isAdmin() || isClassTeacher(classId))
          // Byline is pinned to the writer, same as announcements and sport.
          && request.resource.data.AuthorId == request.auth.uid;

        // AuthorId immutable: an edit must not reassign someone else's chapter.
        allow update: if (isAdmin() || isClassTeacher(classId))
          && request.resource.data.AuthorId == resource.data.AuthorId;

        allow delete: if isAdmin() || isClassTeacher(classId);
      }

      // ---- AI textbook imports -----------------------------------------
      //
      // A teacher uploads a textbook PDF; the generateTextbookOutline and
      // generateTextbookChapter Cloud Functions (Gemini on Vertex AI) write
      // DRAFT units, notes and quiz questions here. Nothing here is visible to
      // students: drafts live in their own subtree rather than as flagged
      // documents in /units or /materials, because rules filter documents, not
      // queries — one hidden draft in /units would make every student's list
      // of units fail outright. Publishing copies a chapter into the real
      // collections through the ordinary teacher paths above.
      //
      // The functions use the Admin SDK and bypass these rules. Status changes
      // the teacher may make are deliberately narrow: they can retry a failed
      // chapter (Pending), mark one Published, and edit its words.
      match /textbookJobs/{jobId} {
        allow read, delete: if isAdmin() || isClassTeacher(classId);

        // Only a fresh, queued job, requested by the writer. The function picks
        // it up on create; anything else would never be processed.
        allow create: if (isAdmin() || isClassTeacher(classId))
          && request.resource.data.RequestedBy == request.auth.uid
          && request.resource.data.Status == 'Queued';

        // The teacher records where the original PDF was attached; progress
        // fields belong to the function.
        allow update: if (isAdmin() || isClassTeacher(classId))
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['TextbookMaterialId', 'UpdatedAt']);

        match /chapters/{chapterId} {
          allow read, delete: if isAdmin() || isClassTeacher(classId);

          // Created only by the function.
          allow create: if false;

          allow update: if (isAdmin() || isClassTeacher(classId))
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['Title', 'Notes', 'Status', 'Error', 'UpdatedAt',
                           'PublishedUnitId', 'PublishedMaterialId', 'PublishedAssignmentId'])
            && request.resource.data.Status in ['Pending', 'Ready', 'Published'];

          // Draft questions, answer included. Teacher-only, like answerKeys.
          match /questions/{questionId} {
            allow read, delete: if isAdmin() || isClassTeacher(classId);
            allow create, update: if false;
          }
        }
      }
    }

    // ---- teacher-parent conversations -------------------------------------

    // One thread per teacher, parent AND child:
    //   /conversations/{teacherId}_{parentId}_{studentId}
    // The ID is fixed by its three parts so the same three people can never
    // end up with two parallel threads.
    //
    // A conversation can only be OPENED for a real relationship, checked here
    // rather than trusted from the app: the child must be in a class that
    // teacher teaches, and linked to that parent. That's what "the parent is
    // linked to the teacher" means — nobody records it; it follows from the
    // class roster and the parent's LinkedStudentIds.
    //
    // Admins can read every thread. A private channel between a teacher and a
    // family is exactly where a school needs a record it can look at if a
    // dispute comes up — the app says so to both sides.
    match /conversations/{conversationId} {
      function convo() {
        return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
      }

      allow read: if isSignedIn() && (request.auth.uid in resource.data.ParticipantIds || isAdmin());

      allow create: if isSignedIn()
        && conversationId == request.resource.data.TeacherId + '_' + request.resource.data.ParentId
                             + '_' + request.resource.data.StudentId
        && request.resource.data.ParticipantIds == [request.resource.data.TeacherId, request.resource.data.ParentId]
        && (request.auth.uid == request.resource.data.TeacherId || request.auth.uid == request.resource.data.ParentId)
        && classDoc(request.resource.data.ClassId).TeacherId == request.resource.data.TeacherId
        && request.resource.data.StudentId in classDoc(request.resource.data.ClassId).StudentIds
        && request.resource.data.StudentId in
             get(/databases/$(database)/documents/users/$(request.resource.data.ParentId)).data.get('LinkedStudentIds', []);

      // Participants only move the "last message" summary along, as themselves.
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.ParticipantIds
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['LastMessageAt', 'LastMessagePreview', 'LastSenderId'])
        && request.resource.data.LastSenderId == request.auth.uid;

      // It's a record: only an admin removes a thread.
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isSignedIn() && (request.auth.uid in convo().ParticipantIds || isAdmin());

        allow create: if isSignedIn()
          && request.resource.data.AuthorId == request.auth.uid
          && request.auth.uid in convo().ParticipantIds
          && request.resource.data.keys().hasOnly(['AuthorId', 'AuthorName', 'Text', 'SentAt'])
          && request.resource.data.Text is string
          && request.resource.data.Text.size() > 0
          && request.resource.data.Text.size() <= 2000
          && request.resource.data.SentAt is timestamp
          && request.resource.data.SentAt > request.time - duration.value(10, 'm')
          && request.resource.data.SentAt < request.time + duration.value(10, 'm');

        // No editing or deleting by either side: both are relying on this as
        // the record of what was said. Admins can remove (e.g. abuse).
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // ---- timetable -------------------------------------------------------

    // Teachers build the timetable for classes they own; admins for any class.
    match /timetable/{entryId} {
      allow read: if isSchoolCommunity();
      allow create, update: if isAdmin() ||
        (isTeacher() && isClassTeacher(request.resource.data.ClassId));
      allow delete: if isAdmin() ||
        (isTeacher() && isClassTeacher(resource.data.ClassId));
    }

    // School newspaper ("Newspaper" in the app). Journalists are usually
    // students, so this is the one place a student can publish to the whole
    // school — and only here.
    //
    // Articles go live the moment they're written: there is no draft or
    // approval step. That was a deliberate product choice, so the safety net
    // is AFTER publication instead — any teacher or admin can take an article
    // down (delete), but only its author or an admin can change its words.
    // A teacher rewriting a student's article under the student's byline would
    // be worse than removing it.
    //
    // Read by the school community only, not visitors or guests: these are
    // students writing under their own names, which is a different audience
    // decision from a fixture list. Journalist is added explicitly because an
    // account whose PRIMARY role is Journalist isn't in isSchoolCommunity(),
    // and a journalist who can't read their own paper would be absurd.
    match /newspaper/{articleId} {
      allow read: if isSchoolCommunity() || isJournalist();

      // Byline pinned to the writer, same as everywhere else.
      allow create: if (isJournalist() || isAdmin())
        && request.resource.data.AuthorId == request.auth.uid;

      // Authorship is immutable for everyone: without this an author could
      // hand an article to someone else, or claim another's work.
      allow update: if request.resource.data.AuthorId == resource.data.AuthorId && (
        isAdmin()
        || (isJournalist() && resource.data.AuthorId == request.auth.uid)
      );

      // Take-down. Teachers are included so a problem article can be removed
      // straight away without waiting for an admin.
      allow delete: if isAdmin() || isTeacher()
        || (isJournalist() && resource.data.AuthorId == request.auth.uid);
    }

    // ---- announcements --------------------------------------------------

    // School-wide notices. Everyone signed in reads them, including visitors —
    // that's the point of a notice board. Only admins write.
    //
    // Visitors are deliberately included in the read: an open day notice is
    // exactly the kind of thing a prospective parent should see. Anything
    // genuinely internal belongs in a class, not here.
    match /announcements/{announcementId} {
      // isSchoolCommunity(), not isSignedIn(): a signed-in Visitor is a member
      // of the database but not of the school, so they see only what's been
      // explicitly marked public. This preserves the audience split the
      // previous rule had — worth keeping, since "open day" and "Grade 11 exam
      // timetable" are not the same audience.
      allow read: if resource.data.get('IsPublic', false) == true || isSchoolCommunity();

      allow create: if isAdmin()
        // Pin authorship to the account doing the writing, so the byline can't
        // be forged even by another admin.
        && request.resource.data.AuthorId == request.auth.uid;

      // AuthorId is immutable after creation: an edit must not be able to
      // reassign a notice to a different admin.
      allow update: if isAdmin()
        && request.resource.data.AuthorId == resource.data.AuthorId;

      allow delete: if isAdmin();
    }

    // ---- sports ---------------------------------------------------------

    // Fixtures, results and sports news. Read by anyone signed in.
    //
    // Write is wider than announcements: coaches run the fixtures, admins
    // cover for an unassigned sport, and journalists file match reports. The
    // journalist branch is narrower than the other two — they may only touch
    // their own posts, which is what stops a student rewriting a coach's
    // result or deleting a fixture they dislike.
    // ---- teams and squads -------------------------------------------------

    match /teams/{teamId} {

      // Readable by the whole school community, same as a class document and
      // for the same reason: a squad list is directory-level information within
      // a school, and a LIST query fails entirely if any one document denies.
      // What's private is the notices below, not the fact a team exists.
      allow read: if isSchoolCommunity();

      // Create is separate from update: isTeamCoach() get()s a document that
      // doesn't exist yet. A coach may only create a team owned by themselves,
      // which is what stops one coach creating a team in another's name.
      allow create: if isAdmin() ||
        (isCoach() && request.resource.data.CoachId == request.auth.uid);

      // Ownership is immutable. Without this a coach could hand their team to
      // someone else, or take one, by editing a single field.
      allow update: if (isAdmin() || isTeamCoach(teamId))
        && request.resource.data.CoachId == resource.data.CoachId;

      allow delete: if isAdmin() || isTeamCoach(teamId);

      // ---- team notices ---------------------------------------------------
      //
      // Practice times, kit, meeting points, game-day details. Identical shape
      // to class announcements: the PATH carries the team, so membership gates
      // the read and ownership gates the write, with no client-side filtering
      // and no way for a list query to hand one squad's notices to another.
      match /notices/{noticeId} {
        allow read: if isAdmin() || isTeamCoach(teamId) || isTeamMember(teamId) ||
          isParentOfTeamMember(teamId);

        allow create: if (isAdmin() || isTeamCoach(teamId))
          // Byline pinned to the writer, same as everywhere else.
          && request.resource.data.AuthorId == request.auth.uid;

        allow update: if (isAdmin() || isTeamCoach(teamId))
          && request.resource.data.AuthorId == resource.data.AuthorId;

        allow delete: if isAdmin() || isTeamCoach(teamId);
      }
    }

    match /sports/{itemId} {
      // Sport was public-facing under the old rules and stays that way — a
      // fixture list is exactly what a prospective parent looks for.
      allow read: if true;

      allow create: if (isCoach() || isAdmin() || isJournalist())
        && request.resource.data.AuthorId == request.auth.uid;

      allow update: if isCoach() || isAdmin() || (
        isJournalist()
        && resource.data.AuthorId == request.auth.uid
        && request.resource.data.AuthorId == resource.data.AuthorId
      );

      allow delete: if isCoach() || isAdmin() ||
        (isJournalist() && resource.data.AuthorId == request.auth.uid);
    }
  }
}
